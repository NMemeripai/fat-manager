# Firebase: pegá acá el contenido COMPLETO del archivo JSON de tu cuenta de servicio
# (lo descargás desde la consola de Firebase, ver README). Tiene que ir en una sola línea.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...":"..."}

# Alternativa: en vez de la línea de arriba, podés dejar el archivo serviceAccountKey.json
# en esta misma carpeta y borrar/comentar la variable FIREBASE_SERVICE_ACCOUNT_JSON.

# Cloudinary: los 3 datos están en el dashboard principal de tu cuenta de Cloudinary
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu-api-secret

JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
PORT=3001
